# LocoTrader — Environment Variables
# Copy this to .env and fill in your values

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Gemini AI (users provide their own key in-app, this is for development)
GEMINI_API_KEY=your-gemini-key-here

# RevenueCat (for IAP)
REVENUECAT_API_KEY_ANDROID=your-rc-android-key
REVENUECAT_API_KEY_IOS=your-rc-ios-key
