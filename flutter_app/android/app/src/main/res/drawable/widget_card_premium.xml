<?xml version="1.0" encoding="utf-8"?>
<!-- Premium card surface: layered diagonal gradient + subtle hairline border -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="225"
                android:startColor="#1B2434"
                android:centerColor="#121821"
                android:endColor="#0A0E14"
                android:type="linear" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="#1F2A3A" />
        </shape>
    </item>
    <!-- Inner glow highlight at the top edge for a premium glass feel -->
    <item android:bottom="2dp">
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#10FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
