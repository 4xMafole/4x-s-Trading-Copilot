<?xml version="1.0" encoding="utf-8"?>
<!--
    Premium home-screen widget for 4x Trades.
    All view IDs preserved — see TradingStatusWidgetProvider.kt for bindings.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_premium"
    android:padding="2dp">

    <!--
        Vertical accent rail (left edge). Three overlay rails — Kotlin toggles
        visibility based on session state (ACTIVE / STANDBY / LOCKED). Reuses
        the existing stripeActive / stripeStandby / stripeLocked IDs so no
        provider change is required.
    -->
    <FrameLayout
        android:layout_width="5dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/stripeActive"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_rail_active"
            android:visibility="gone" />

        <TextView
            android:id="@+id/stripeStandby"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_rail_standby"
            android:visibility="visible" />

        <TextView
            android:id="@+id/stripeLocked"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_rail_locked"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Content column -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <!-- Brand row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/widget_brand_dot" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.22"
                android:text="4X TRADES"
                android:textColor="#9BB2D2"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widgetBadgeActive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_badge_active"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.18"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="ACTIVE"
                android:textColor="#3DDB9A"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widgetBadgeStandby"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_badge_standby"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.18"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="STANDBY"
                android:textColor="#F9C74F"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="visible" />

            <TextView
                android:id="@+id/widgetBadgeLocked"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_badge_locked"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.18"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="LOCKED"
                android:textColor="#FF7B72"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widgetRefresh"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_refresh_chip"
                android:gravity="center"
                android:text="↻"
                android:textColor="#9BB2D2"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Session hero -->
        <TextView
            android:id="@+id/widgetSessionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium"
            android:text="Loading session..."
            android:textColor="#F2F6FB"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widgetNextSession"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.04"
            android:text=""
            android:textColor="#7A8DA8"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- Hairline divider -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="11dp"
            android:background="@drawable/widget_divider" />

        <!-- Stats row: trade slots + PnL pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widgetTradesRemaining"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/widget_slots_pill"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="◯  ◯   Loading plan..."
                android:textColor="#C2CBD8"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widgetPnl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_pnl_pill"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.02"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="P/L  --"
                android:textColor="#E6EEF8"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Footer micro-line -->
        <TextView
            android:id="@+id/widgetUpdated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.08"
            android:text="UPDATED --:--"
            android:textColor="#5C6F8B"
            android:textSize="9sp" />

    </LinearLayout>
</FrameLayout>
